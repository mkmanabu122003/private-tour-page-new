# Client-visible WhatsApp number for the tour sticky bar.
# Digits with country code. Leave unset to hide the WhatsApp button.
# PUBLIC_WHATSAPP_NUMBER=TODO_SET_IN_NETLIFY
# VITE_PUBLIC_WHATSAPP_NUMBER=TODO_SET_IN_NETLIFY

# reCAPTCHA v2 (checkbox) for the inquiry form. In production both live in the
# Netlify UI: SITE_RECAPTCHA_KEY (scope: Builds + Runtime) and
# SITE_RECAPTCHA_SECRET (scope: Runtime). Netlify verifies the token itself.
# Locally you only ever need the site key; leave it unset to run without captcha.
# PUBLIC_RECAPTCHA_SITE_KEY=TODO_SET_IN_NETLIFY
